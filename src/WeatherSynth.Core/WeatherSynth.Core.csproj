<Project Sdk="Microsoft.NET.Sdk">
  <!--
      The calculation library.
    -->
  <PropertyGroup>
    <RootNamespace>WeatherSynth</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Packaging. This is the core physics library. Not really needed on its own. Just a dependency for the data package-->
  <PropertyGroup>
    <PackageId>WeatherSynth.Core</PackageId>
    <Description>Physics core for WeatherSynth: clear-sky solar irradiance, solar geometry, wind profile transfer and turbine power curves. Pulled in automatically by the WeatherSynth package.</Description>
    <PackageTags>weather;solar;wind;synthetic-data;simulation;pv;renewable-energy</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SolarCalculator" Version="3.6.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the internals visible to the data package, the tests, and the sample project. -->
    <InternalsVisibleTo Include="WeatherSynth.Data" />
    <InternalsVisibleTo Include="WeatherSynth.Core.Tests" />
    <InternalsVisibleTo Include="WeatherSynth.Sample" />
  </ItemGroup>
</Project>
