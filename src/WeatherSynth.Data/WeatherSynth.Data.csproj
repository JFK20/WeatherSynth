<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that touches the outside world: file parsing, and later, downloads. -->
  <PropertyGroup>
    <RootNamespace>WeatherSynth.Data</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Packaging. The Actual Package you need. This Package allows you to generate synthetic weather data -->
  <PropertyGroup>
    <PackageId>WeatherSynth</PackageId>
    <Description>A stochastic weather generator: synthetic, physically-plausible daily solar irradiance and wind speed for a site.
      Two Possible options either use the bundled default model with zero setup, or fit your own from a DWD station record.</Description>
    <PackageTags>weather;solar;wind;synthetic-data;simulation;pv;renewable-energy;game-development</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WeatherSynth.Core/WeatherSynth.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WeatherSynth.Core.Tests" />
    <InternalsVisibleTo Include="WeatherSynth.Sample" />
  </ItemGroup>
</Project>
