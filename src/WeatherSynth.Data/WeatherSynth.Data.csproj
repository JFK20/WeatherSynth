<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that touches the outside world: file parsing, and later, downloads. -->
  <PropertyGroup>
    <RootNamespace>WeatherSynth.Data</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WeatherSynth.Core/WeatherSynth.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DWD readers, the day aggregators and the series builders are internal: a caller
             reaches the record through a provider's FromDwdRecord, and the -999 sentinel and the
             J/cm² conversion are ours to change.

             Single-line parsing is an implementation detail, but it is where those two live, so the
             tests need at it. The sample needs at all of it - its summary and calibration reports
             work on raw intervals. WeatherSynth.Api.Tests is deliberately absent, so that it sees
             what a package consumer sees and nothing else. -->
    <InternalsVisibleTo Include="WeatherSynth.Core.Tests" />
    <InternalsVisibleTo Include="WeatherSynth.Sample" />
  </ItemGroup>
</Project>
